{
  "name": "feedfold",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "A quiet, keyboard-first feed reader for the desktop or your own server.",
  "author": "feedfold contributors",
  "license": "MIT",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:desktop": "npm run build:desktop:runtime && concurrently -k -n client,desktop -c cyan,magenta \"vite --host 127.0.0.1\" \"node scripts/start-desktop-dev.mjs\"",
    "dev:server": "PORT=${PORT:-43001} tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "node scripts/wait-for-server.mjs && vite",
    "build": "npm run build:client && npm run build:server && npm run build:desktop:runtime",
    "build:client": "vite build",
    "build:demo": "FEEDFOLD_BASE_PATH=/ VITE_FEEDFOLD_DEMO=true vite build",
    "deploy:demo": "npm run build:demo && wrangler deploy",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist/server --packages=external --sourcemap",
    "build:desktop:runtime": "npm run build:desktop:main && npm run build:desktop:preload",
    "build:desktop:main": "esbuild src/desktop/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/desktop/main.js --packages=external --sourcemap",
    "build:desktop:preload": "esbuild src/desktop/preload.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/desktop/preload.cjs --packages=external --sourcemap",
    "desktop": "node scripts/run-desktop.mjs",
    "desktop:prepare-browser": "node scripts/prepare-desktop-browser.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:package:local": "FEEDFOLD_LOCAL_SIGNING_IDENTITY='feedfold Local Code Signing' node scripts/package-desktop.mjs",
    "desktop:package:dir": "node scripts/package-desktop.mjs --dir",
    "desktop:smoke:packaged": "node scripts/smoke-packaged-desktop.mjs",
    "build:desktop": "npm run build:client && npm run build:desktop:runtime",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "argon2": "0.45.1",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.1",
    "feedsmith": "2.9.6",
    "jsdom": "29.1.1",
    "lucide-react": "1.24.0",
    "parse-srcset": "1.0.2",
    "playwright": "1.62.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sanitize-html": "2.17.7",
    "sonner": "2.0.7",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@electron/rebuild": "4.2.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/jsdom": "28.0.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "9.2.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  },
  "overrides": {
    "brace-expansion@<1.1.17": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.3": "2.1.4"
  },
  "build": {
    "appId": "com.feedfold.app",
    "productName": "feedfold",
    "afterPack": "scripts/after-pack.mjs",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/client/**/*",
      "dist/desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/playwright-core/.local-browsers/**/*"
    ],
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.news",
      "icon": "build-resources/feedfold.png",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
